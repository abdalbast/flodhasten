# Flodhästen Environment Configuration
# =====================================
# 
# This file contains placeholder values for environment variables.
# Copy this file to .env and replace the placeholder values with your actual keys.
#
# SECURITY WARNING:
# - Never commit .env files to version control
# - Keep your API keys secure and private
# - Rotate keys regularly
# - Use different keys for development and production

# Azure Cognitive Services Translator API
# Get your key from: https://portal.azure.com/
# 1. Create a Translator resource
# 2. Go to Keys and Endpoint section
# 3. Copy Key 1 or Key 2
AZURE_TRANSLATION_KEY=your_azure_translation_key_here

# Azure region for your Translator resource
# Common regions: westeurope, eastus, southeastasia
AZURE_TRANSLATION_REGION=westeurope

# Server Configuration
# Port for the translation proxy server
PORT=4000

# Development Configuration
# Set to 'development' for additional logging
NODE_ENV=development

# Translation Security
# Generate a secure random string for HMAC signing
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TRANSLATE_SECRET=your_translate_secret_here

# Client-side Translation Secret (for React app)
# This should be different from the server secret
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REACT_APP_TRANSLATE_SECRET=your_client_translate_secret_here

# =====================================
# Setup Instructions:
# 1. Copy this file: cp .env.example .env
# 2. Edit .env and replace placeholder values
# 3. Get Azure Translation API key from Azure portal
# 4. Generate secure secrets for HMAC signing
# 5. Test with: npm run setup-env
# =====================================
